    {
      "id": 14,
      "type": "row",
      "title": "Oversampling layer",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "barchart",
      "title": "Rows generated per refresh",
      "description": "Rows created by the sdi_generate_data DAG for each new 3-month period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 9,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'Refresh ' || refresh_no || ' (' || to_char(min(period_start), 'Mon') || '-' || to_char(max(period_end), 'Mon YY') || ')' AS \"Refresh\",\n       sum(rows_generated) FILTER (WHERE source_name = 'sales') AS \"Sales\",\n       sum(rows_generated) FILTER (WHERE source_name = 'hospital_demand') AS \"Hospital demand\",\n       sum(rows_generated) FILTER (WHERE source_name = 'master') AS \"Master (price changes)\"\nFROM ops.generation_log\nGROUP BY refresh_no\nORDER BY refresh_no"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Refresh",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Load log (latest first)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 9,
        "y": 27,
        "w": 15,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(started_at AT TIME ZONE 'Asia/Karachi', 'DD Mon HH24:MI:SS') AS \"Started\",\n       coalesce(substring(file_name from '_(R[0-9]+|API)_'), '') AS \"Batch\", source_name AS \"Source\",\n       rows_loaded AS \"Loaded\", rows_rejected AS \"Rejected\",\n       duration_sec AS \"Seconds\", status AS \"Status\"\nFROM ops.batch_load_log\nORDER BY started_at DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "green",
                        "index": 0
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}