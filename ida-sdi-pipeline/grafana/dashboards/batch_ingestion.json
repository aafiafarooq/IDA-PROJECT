    {
      "id": 9,
      "type": "barchart",
      "title": "Load duration (s) per file source",
      "description": "Timestamp_end - Timestamp_start per file load. Shows which source takes longest.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source_name AS \"Source\",\n       round(avg(duration_sec), 2) AS \"Average\",\n       round(max(duration_sec), 2) AS \"Slowest\"\nFROM ops.batch_load_log\nGROUP BY source_name\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Source",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Load duration (s) per file",
      "description": "Every file the watcher has loaded, oldest at top. R0 = original data, R1-R4 = generated refreshes, API = uploaded through the ingestion API.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source_name || ' ' || coalesce(substring(file_name from '_(R[0-9]+|API)_'), '') AS \"File\", duration_sec AS \"Duration\"\nFROM ops.batch_load_log\nORDER BY started_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "File",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
