    {
      "id": 6,
      "type": "row",
      "title": "Storage breakdown",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Share of rows by source",
      "description": "SELECT COUNT(*) per staging table, as % of all staged rows",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT replace(table_name, 'staging.stg_', '') AS \"Table\", row_count AS \"Rows\"\nFROM ops.storage_metrics WHERE captured_at = (SELECT max(captured_at) FROM ops.storage_metrics) AND row_count IS NOT NULL\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Share of storage (MB) by source",
      "description": "pg_total_relation_size (table + indexes) per staging table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 7,
        "y": 6,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT replace(table_name, 'staging.stg_', '') AS \"Table\", size_mb AS \"MB\"\nFROM ops.storage_metrics WHERE captured_at = (SELECT max(captured_at) FROM ops.storage_metrics) AND table_name <> 'DATABASE TOTAL'\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Row count & date coverage per table",
      "description": "Date coverage span = MAX(date) - MIN(date) per table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 6,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT replace(table_name, 'staging.stg_', '') AS \"Table\", row_count AS \"Rows\",\n       to_char(first_date, 'YYYY-MM-DD') AS \"First date\", to_char(last_date, 'YYYY-MM-DD') AS \"Last date\", coverage_days AS \"Days covered\",\n       round(coverage_days / 365.25, 1) AS \"Years\"\nFROM ops.storage_metrics WHERE captured_at = (SELECT max(captured_at) FROM ops.storage_metrics) AND row_count IS NOT NULL\nORDER BY row_count DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Growth across refreshes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Cumulative staged rows after each load",
      "description": "New data is appended, never replaced: staging keeps growing with each refresh.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH b AS (\n  SELECT batch_id, min(started_at) AS t,\n         string_agg(DISTINCT substring(file_name from '_(R[0-9]+|API)_'), '+') AS tag,\n         sum(rows_loaded) FILTER (WHERE source_name = 'sales') AS s,\n         sum(rows_loaded) FILTER (WHERE source_name = 'hospital_demand') AS h,\n         sum(rows_loaded) FILTER (WHERE source_name = 'master') AS m\n  FROM ops.batch_load_log WHERE status = 'SUCCESS'\n  GROUP BY batch_id)\nSELECT coalesce(tag, '?') || ' (' || to_char(t AT TIME ZONE 'Asia/Karachi', 'DD Mon HH24:MI') || ')' AS \"Load\",\n       sum(coalesce(s, 0)) OVER (ORDER BY t) AS \"Sales\",\n       sum(coalesce(h, 0)) OVER (ORDER BY t) AS \"Hospital demand\",\n       sum(coalesce(m, 0)) OVER (ORDER BY t) AS \"Master\"\nFROM b ORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Load",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Date coverage by table (months)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 16,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT replace(table_name, 'staging.stg_', '') AS \"Table\",\n       round(coverage_days / 30.44, 1) AS \"Months covered\"\nFROM ops.storage_metrics WHERE captured_at = (SELECT max(captured_at) FROM ops.storage_metrics) AND row_count IS NOT NULL\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Months covered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Table",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.75,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
